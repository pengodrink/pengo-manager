# Copy this file to ".env.local" and fill in the values.

# --- Required: Supabase app connection ---
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional: lets Claude run DB migrations for you (account-level token) ---
# Supabase Dashboard -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Optional: daily low-stock email alert (set these in Vercel to enable) ---
# SUPABASE_SERVICE_ROLE_KEY: Supabase -> Project Settings -> API (keep secret!)
# RESEND_API_KEY: resend.com -> API Keys
# ALERT_EMAIL: where the alert is sent, e.g. you@pengodrink.com
# ALERT_FROM: optional verified sender; defaults to Resend's test sender
# CRON_SECRET: optional shared secret; Vercel Cron sends it as a Bearer token
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ALERT_EMAIL=
ALERT_FROM=
CRON_SECRET=
